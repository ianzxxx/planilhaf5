generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Funcionario {
  id                   String          @id @default(cuid())
  nome                 String          @default("")
  cargo                String?
  horarioEntradaPadrao String?
  horarioSaidaPadrao   String?
  minutosAlmocoPadrao  Int?            @default(60)
  ativo                Boolean         @default(true)
  createdAt            DateTime        @default(now())
  registros            RegistroPonto[]
}

model RegistroPonto {
  id               String      @id @default(cuid())
  funcionarioId    String
  funcionario      Funcionario @relation(fields: [funcionarioId], references: [id])
  data             String
  /** trabalho | falta | folga | atestado */
  tipoDia          String      @default("trabalho")
  horaEntrada      String?
  horaSaidaAlmoco  String?
  horaVoltaAlmoco  String?
  horaSaida        String?
  horasTrabalhadas Float?
  observacao       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([data])
  @@index([funcionarioId])
  @@index([funcionarioId, data])
  @@index([tipoDia])
}
